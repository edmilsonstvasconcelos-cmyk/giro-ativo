# ──────────────────────────────────────────────────────────────
# Supabase — obrigatório
# Encontre em: https://supabase.com/dashboard → Settings → API
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# ──────────────────────────────────────────────────────────────
# URL pública da aplicação — obrigatório em produção
# Na Vercel, use a URL do projeto: https://<seu-projeto>.vercel.app
# ou o domínio customizado: https://giroativo.com.br
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://<seu-projeto>.vercel.app
